{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/guides/run-gguf-on-android",
      "dest": "/guides/run-gguf-on-android.html"
    },
    {
      "src": "/guides/phone-as-local-ai-server",
      "dest": "/guides/phone-as-local-ai-server.html"
    },
    {
      "src": "/guides/best-small-models",
      "dest": "/guides/best-small-models.html"
    },
    {
      "src": "/compare/snor-vs-pocketpal",
      "dest": "/compare/snor-vs-pocketpal.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html"
    }
  ]
}
